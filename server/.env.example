# Copy to .env for local development. Never commit the real .env.
# In staging/production these are injected by the platform's secret store,
# not read from a file.

ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Minimum 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-generated-value-at-least-32-chars

# JSON array. Empty in local dev because the Vite proxy keeps calls same-origin.
CORS_ORIGINS=["http://localhost:5173"]

# Groq API key for The Gaffer's knowledge-grounded responses.
# Get a free key at https://console.groq.com/
# NEVER share this value or commit the real .env file.
GROQ_API_KEY=

# Groq model to use (default: openai/gpt-oss-120b, requires reasoning_effort parameter)
GROQ_MODEL=openai/gpt-oss-120b

# Groq speech-to-text model for voice input (default: whisper-large-v3-turbo)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Groq text-to-speech model (default: canopylabs/orpheus-v1-english).
# Requires its own terms acceptance, separate from the main API key --
# accept at https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Voice name for TTS. No default -- see the voice roster at
# https://console.groq.com/docs/text-to-speech once terms are accepted above.
# Voice output returns a clear error until this is set; chat and voice input
# work fine without it.
GROQ_TTS_VOICE=
