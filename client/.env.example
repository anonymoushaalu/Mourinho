# Copy to .env.local. Only VITE_-prefixed vars are exposed to the browser.
# NEVER put a secret here — everything below ships in the bundle.

# Empty string in dev: requests stay same-origin and hit the Vite proxy.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api to.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
